{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "OnFailure",
    "restartPolicyMaxRetries": 10,
    "runtime": "IMAGE",
    "image": {
      "dockerFilePath": "Dockerfile"
    },
    "healthcheck": {
      "path": "/docs",
      "port": 8000,
      "protocol": "http"
    }
  },
  "variables": {
    "PYTHON_VERSION": "3.11",
    "ENVIRONMENT": "production"
  }
}