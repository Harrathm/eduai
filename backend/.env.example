# ============================================
# EDUAI Learning — Backend .env.example
# ============================================
# Copy to .env and fill in real values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql+pg8000://postgres:CHANGE_ME@localhost:5432/eduai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# --- JWT Security ---
# Must be >= 32 characters in production
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_ORG_ID=

# --- Groq ---
GROQ_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- MiniMax (OpenAI-compatible) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://inference.dahl.global/v1

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_teacher_pro
STRIPE_PRICE_SCHOOL=price_school
STRIPE_PRICE_INSTITUTION=price_institution

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Environment ---
ENVIRONMENT=development

# --- Redis (optional, for rate limiting) ---
REDIS_URL=
