# ── Database ──────────────────────────────────────────────
POSTGRES_DB=eduai
POSTGRES_USER=eduai_user
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+pg8000://eduai_user:CHANGE_ME@localhost:5432/eduai

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AI Provider (Groq / OpenAI) ──────────────────────────
OPENAI_API_KEY=
OPENAI_ORG_ID=

# ── Stripe (optional) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCHOOL=
STRIPE_PRICE_INSTITUTION=

# ── Konnect (Tunisian payment gateway) ───────────────────
KONNECT_API_KEY=
KONNECT_MERCHANT_ID=
KONNECT_WEBHOOK_SECRET=

# ── SMTP (email sending) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM_ADDRESS=noreply@eduai.tn
EMAIL_FROM_NAME=EDUAI Learning
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# ── Redis (optional, falls back to in-memory) ───────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Environment ──────────────────────────────────────────
ENVIRONMENT=development
