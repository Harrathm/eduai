# ══════════════════════════════════════════════════════════════
# EDUAI Backend - Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED PROD] MUST be set in production.
# ══════════════════════════════════════════════════════════════

# ── Environment ──────────────────────────────────────────────
# [REQUIRED PROD] Set to "production" on live servers.
# Options: development | staging | production
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────
# [REQUIRED PROD] PostgreSQL connection string.
# Format: postgresql+pg8000://user:password@host:port/dbname
DATABASE_URL=postgresql+pg8000://eduai_user:CHANGE_ME@localhost:5432/eduai

# ── JWT / Auth ───────────────────────────────────────────────
# [REQUIRED PROD] Secret key for signing JWTs (min 32 chars in production).
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default: 30)
JWT_EXPIRE_MINUTES=30
# Refresh token lifetime in days (default: 7)
JWT_REFRESH_EXPIRE_DAYS=7

# ── OpenAI ───────────────────────────────────────────────────
# Required for GPT-based chat, embeddings, and RAG features.
OPENAI_API_KEY=
# Optional: your OpenAI organization ID
OPENAI_ORG_ID=

# ── Groq ─────────────────────────────────────────────────────
# Required for Groq-hosted LLM inference (Llama, Mixtral, etc.).
GROQ_API_KEY=

# ── OpenRouter ───────────────────────────────────────────────
# Required for OpenRouter-hosted models.
OPENROUTER_API_KEY=

# ── MiniMax (OpenAI-compatible) ──────────────────────────────
# Required for MiniMax-hosted models.
MINIMAX_API_KEY=
# MiniMax API base URL (default: https://inference.dahl.global/v1)
MINIMAX_BASE_URL=https://inference.dahl.global/v1

# ── Stripe ───────────────────────────────────────────────────
# Required for Stripe payment processing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for each plan tier
STRIPE_PRICE_PRO=price_teacher_pro
STRIPE_PRICE_SCHOOL=price_school
STRIPE_PRICE_INSTITUTION=price_institution

# ── Konnect (Tunisian payment gateway) ───────────────────────
# Required for Konnect payment processing.
KONNECT_API_KEY=
KONNECT_MERCHANT_ID=
KONNECT_WEBHOOK_SECRET=

# ── SMTP / Email ─────────────────────────────────────────────
# Required for sending password-reset and notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
EMAIL_FROM_ADDRESS=noreply@eduai.tn
EMAIL_FROM_NAME=EDUAI Learning
# URL base for password-reset links (must match frontend route)
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# ── CORS ─────────────────────────────────────────────────────
# [REQUIRED PROD] Comma-separated list of allowed origins.
# In development, defaults to "*" if not set.
ALLOWED_ORIGINS=http://localhost:5173

# ── Course Marketplace ───────────────────────────────────────
# Max price (TND) a teacher can set for an independent course
MAX_INDEPENDENT_COURSE_PRICE=500.0
# Max progress (%) before a refund is blocked
REFUND_MAX_PROGRESS_PERCENT=20.0
# EDUAI commission rate (%) on independent course sales
DEFAULT_COMMISSION_RATE=30.0
