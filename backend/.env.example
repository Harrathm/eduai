# ── Database ──────────────────────────────────────────────
POSTGRES_DB=eduai
POSTGRES_USER=eduai_user
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+pg8000://eduai_user:CHANGE_ME@localhost:5432/eduai

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AI Provider (Groq / OpenAI) ──────────────────────────
OPENAI_API_KEY=
OPENAI_ORG_ID=

# ── Stripe (optional) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCHOOL=
STRIPE_PRICE_INSTITUTION=

# ── Konnect (Tunisian payment gateway) ───────────────────
KONNECT_API_KEY=
KONNECT_MERCHANT_ID=
KONNECT_WEBHOOK_SECRET=

# ── Environment ──────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
